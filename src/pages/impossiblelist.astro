---
import Layout from "@/layouts/Layout.astro";
import HeaderTopRow from "@components/layout/HeaderTopRow.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import { resolveNavMenuLinks } from "@/utils/nav-menu-utils";
import ImpossibleListPage from "@/components/custom/ImpossibleListPage";

// 解析导航菜单链接供抽屉面板使用
const navMenuLinks = resolveNavMenuLinks();
---

<Layout title="Impossible List" description="The Impossible List">
	<!-- 1. 挂载官方顶部导航条与移动端抽屉菜单 -->
	<HeaderTopRow />
	<NavMenuPanel links={navMenuLinks} />

	<!-- 2. 外层容器：纯白/纯黑背景，pt-20 预留 80px 避让吸顶导航条 -->
	<main class="impossible-wrapper w-full min-h-screen pt-20 pb-16 bg-white dark:bg-[#000000] flex flex-col items-center overflow-x-hidden">
		<div class="impossible-content-box w-full max-w-[1720px] mx-auto px-4 sm:px-8 xl:px-14 box-border">
			<ImpossibleListPage client:only="react" />
		</div>
	</main>
</Layout>

<style is:global>
	/* 强制覆盖全局背景为纯白（夜间模式为纯黑），清除主题青蓝色彩染 */
	html,
	body {
		width: 100%;
		overflow-x: hidden;
		background-color: #ffffff !important;
		background-image: none !important;
	}

	:root.dark html,
	:root.dark body {
		background-color: #000000 !important;
	}

	/* 确保顶部导航栏层级正确，不被下方内容覆盖 */
	#header,
	header,
	.header-top-row {
		z-index: 50 !important;
	}

	/* 修复 Astro 孤岛容器，继承父级居中对齐 */
	.impossible-wrapper astro-island {
		display: block !important;
		width: 100% !important;
		max-width: 1720px !important;
		margin: 0 auto !important;
	}

	/* 彻底消除 Tailwind v4 translate 偏移与残余样式，锁定屏幕正中 */
	.impossible-wrapper astro-island > div,
	.impossible-wrapper [class*="max-w-[1720px]"] {
		width: 100% !important;
		max-width: 1720px !important;
		position: relative !important;
		left: 0 !important;
		right: 0 !important;
		translate: none !important;
		transform: none !important;
		margin-left: auto !important;
		margin-right: auto !important;
		box-sizing: border-box !important;
	}
</style>