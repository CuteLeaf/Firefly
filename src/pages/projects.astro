---
import { Icon } from "astro-icon/components";
import ProjectsGrid from "@/components/pages/projects/ProjectsGrid.svelte";
import { projectsConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { ProjectItem } from "@/types/projectsConfig";

// 检查页面是否启用
if (!siteConfig.pages.projects) {
	return Astro.redirect("/404/");
}

// 按分类分组项目
const projectsByCategory: Record<string, ProjectItem[]> = {};
for (const project of projectsConfig.projects) {
	if (!projectsByCategory[project.category]) {
		projectsByCategory[project.category] = [];
	}
	projectsByCategory[project.category].push(project);
}

// 是否显示“全部”标签
const showAllTab = projectsConfig.showAllTab !== false;
const totalProjects = projectsConfig.projects.length;

// 构建分类标签，只显示有项目的分类
const categoryTabs = projectsConfig.categories
	.filter((category) => {
		const items = projectsByCategory[category.id];
		return items && items.length > 0;
	})
	.map((category) => ({
		id: category.id,
		name: category.name,
		count: projectsByCategory[category.id].length,
	}));

const allTab = { id: "__all__", name: i18n(I18nKey.all), count: totalProjects };
const tabs = showAllTab ? [allTab, ...categoryTabs] : categoryTabs;

const activeTab = tabs[0]?.id || "";
---

<MainGridLayout title={i18n(I18nKey.projects)} description={i18n(I18nKey.projectsSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="relative w-full mb-8">
        <div class="flex items-center gap-3 mb-3">
          <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
            <Icon is:inline name="material-symbols:folder-copy" class="text-[1.5rem]"></Icon>
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {i18n(I18nKey.projects)}
          </div>
        </div>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
          {i18n(I18nKey.projectsSubtitle)}
        </p>
      </div>

      {tabs.length > 0 ? (
        <ProjectsGrid client:load tabs={tabs} initialActiveTab={activeTab} projects={projectsByCategory} />
      ) : (
        <div class="text-center py-16">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
            <Icon is:inline name="material-symbols:folder-open" class="text-[2rem] text-(--btn-content)" />
          </div>
          <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
            {i18n(I18nKey.projectsEmpty)}
          </h2>
          <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
            {i18n(I18nKey.projectsEmptyDescription)}
          </p>
        </div>
      )}
    </div>
  </div>
</MainGridLayout>
