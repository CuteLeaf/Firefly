---
import { Icon } from "astro-icon/components";
import MalGrid from "@/components/pages/mal/MalGrid.svelte";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { MalListItem } from "@/types/mal";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import {
	fetchMalList,
	type MalCategory,
	type MalListKind,
} from "@/utils/mal-utils";
import { filterNsfw, isMalNsfw } from "@/utils/nsfw-utils";

// 检查页面是否启用
if (!siteConfig.pages.mal) {
	return Astro.redirect("/404/");
}

// 获取构建时间
const buildTime = formatDateI18nWithTime(new Date());

////////////// MyAnimeList 配置 ////////////////////////
const malConfig = {
	username: siteConfig.mal?.username || "",
	clientId: siteConfig.mal?.clientId || "",
	apiUrl: siteConfig.mal?.apiUrl || "https://api.myanimelist.net/v2",
	animeBaseUrl:
		siteConfig.mal?.animeBaseUrl || "https://myanimelist.net/anime/",
	mangaBaseUrl:
		siteConfig.mal?.mangaBaseUrl || "https://myanimelist.net/manga/",
	// 数据获取设置
	pagination: {
		limit: 100, // 每页获取数量
		delay: 100, // 请求间隔毫秒数，避免频率限制
		maxTotal: 1000, // 最大获取总数，防止无限循环（0=无限制）
	},
	// NSFW 处理："off" | "blur" | "hide"
	nsfw: siteConfig.mal?.nsfw ?? "off",
};
//////////////////////////////////////////////////

// 检查是否已配置用户名和 Client ID
const isConfigured =
	malConfig.username.trim() !== "" && malConfig.clientId.trim() !== "";

// 开发模式下只获取一页数据，加快调试速度
const isDev = import.meta.env.DEV;
const maxPages = isDev ? 1 : 0; // 0 表示不限制

/** 获取指定类型的全部列表数据 */
async function fetchAll(kind: MalListKind): Promise<MalListItem[]> {
	const { limit, delay, maxTotal } = malConfig.pagination;
	let offset = 0;
	const allItems: MalListItem[] = [];

	while (true) {
		// 开发模式限制：只获取一页
		if (isDev && maxPages > 0 && allItems.length >= limit * maxPages) {
			console.log(`[MAL] Dev mode: fetched ${maxPages} page(s), stopping`);
			break;
		}

		// 检查是否超过最大获取限制
		if (maxTotal > 0 && allItems.length >= maxTotal) {
			console.log(`[MAL] Reached max fetch limit ${maxTotal}, stopping`);
			break;
		}

		const data = await fetchMalList({
			apiUrl: malConfig.apiUrl,
			username: malConfig.username,
			clientId: malConfig.clientId,
			kind,
			limit,
			offset,
		});
		const batch = data.data || [];
		allItems.push(...batch);

		// 没有下一页或本次获取为空时终止
		if (!data.paging?.next || batch.length === 0) break;
		offset += limit;

		// 添加延迟避免请求过于频繁
		await new Promise((resolve) => setTimeout(resolve, delay));
	}

	return allItems;
}

let animeItems: MalListItem[] = [];
let mangaItems: MalListItem[] = [];
let animeFailed = false;
let mangaFailed = false;

if (isConfigured) {
	console.log(
		`[MAL] ${isDev ? "🔧 Dev mode" : "🌐 Prod mode"} - fetching list for user ${malConfig.username}...`,
	);
	try {
		animeItems = await fetchAll("anime");
		console.log(`[MAL] Anime list: ${animeItems.length} items`);
	} catch (error) {
		console.error("[MAL] Failed to fetch anime list:", error);
		animeFailed = true;
	}
	try {
		mangaItems = await fetchAll("manga");
		console.log(`[MAL] Manga list: ${mangaItems.length} items`);
	} catch (error) {
		console.error("[MAL] Failed to fetch manga list:", error);
		mangaFailed = true;
	}
}

// 两个列表都获取失败才视为整体失败
const fetchFailed = animeFailed && mangaFailed;

// NSFW 拦截：hide 模式下过滤掉 NSFW 条目，保持分类计数一致
animeItems = filterNsfw(animeItems, malConfig.nsfw, isMalNsfw);
mangaItems = filterNsfw(mangaItems, malConfig.nsfw, isMalNsfw);

// 构建分类（空列表的分类不显示）
const categories: MalCategory[] = [];
if (animeItems.length > 0) {
	categories.push({
		id: "anime",
		name: i18n(I18nKey.malCategoryAnime),
		count: animeItems.length,
		items: animeItems,
	});
}
if (mangaItems.length > 0) {
	categories.push({
		id: "manga",
		name: i18n(I18nKey.malCategoryManga),
		count: mangaItems.length,
		items: mangaItems,
	});
}

const activeCategory = categories[0]?.id || "anime";
---

<MainGridLayout title={i18n(I18nKey.mal)} description={i18n(I18nKey.malSubtitle)}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="relative w-full mb-8">
        <div class="mb-6">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
              <Icon name="material-symbols:menu-book" class="text-[1.5rem]"></Icon>
            </div>
            <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
              {i18n(I18nKey.mal)}
            </div>
          </div>
          <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {i18n(I18nKey.malSubtitle)}
          </p>
          <p class="text-xs text-neutral-500 dark:text-neutral-500 mt-2">
            {i18n(I18nKey.malLastUpdated)} {buildTime}
          </p>
        </div>

        {!isConfigured ? (
          /* 未配置提示 */
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.malNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.malNotConfiguredDesc)}
            </p>
          </div>
        ) : fetchFailed ? (
          /* 获取失败提示 */
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:error-outline" class="text-[2rem] text-red-500" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {i18n(I18nKey.malFetchError)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {i18n(I18nKey.malFetchErrorDesc)}
            </p>
          </div>
        ) : categories.length > 0 ? (
          /* 分类网格（Svelte 交互组件） */
          <MalGrid
            client:load
            categories={categories}
            initialActiveCategory={activeCategory}
            animeBaseUrl={malConfig.animeBaseUrl}
            mangaBaseUrl={malConfig.mangaBaseUrl}
            nsfw={malConfig.nsfw}
          />
        ) : (
          /* 空列表提示 */
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
              <Icon name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
            </div>
            <h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
              {isConfigured ? i18n(I18nKey.malEmpty) : i18n(I18nKey.malNotConfigured)}
            </h2>
            <p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
              {isConfigured ? i18n(I18nKey.malEmptyReason) : i18n(I18nKey.malNotConfiguredDesc)}
            </p>
          </div>
        )}
      </div>
    </div>
  </div>
</MainGridLayout>
