---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatFcircleTime } from "@/utils/fcircle-date-utils";
import { type FcircleItem, isValidHttpUrl } from "@/utils/fcircle-utils";

interface Props {
	item: FcircleItem;
	timeZone: string;
}

const { item, timeZone } = Astro.props;

// 发布时间统一按站点时区格式化
const timeStr = formatFcircleTime(item.pubDate, timeZone);

// 确保外链协议安全（防御 javascript: 等伪协议注入）
const safeLink =
	isValidHttpUrl(item.link) ||
	(item.sourceType === "self" && item.link.startsWith("/"))
		? item.link
		: "#";
---

<a
	href={safeLink}
	data-pub-date={item.pubDate.toISOString()}
	target="_blank"
	rel="noopener noreferrer"
	class="fcircle-timeline-card group flex items-start gap-3.5 sm:gap-4 p-3.5 sm:p-4 rounded-xl border border-(--line-divider) bg-(--card-bg) hover:border-(--primary) transition-all duration-300 hover:shadow-md relative overflow-hidden"
>
	<!-- 主题色高亮悬浮背景层 -->
	<div
		class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none"
	></div>

	<!-- 右上角小箭头 -->
	<Icon
		name="material-symbols:arrow-outward-rounded"
		class="absolute top-3.5 right-3.5 sm:top-4 sm:right-4 text-(--primary) text-base sm:text-lg opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 shrink-0"
	/>

	<!-- 作者头像 -->
	<div
		class="relative w-10 h-10 sm:w-11 sm:h-11 shrink-0 rounded-full overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300 mt-0.5"
	>
		<img
			src={item.friendAvatar}
			alt={item.friendName}
			width="44"
			height="44"
			loading="lazy"
			decoding="async"
			class="w-full h-full object-cover"
		/>
	</div>

	<!-- 核心信息主体 -->
	<div class="grow min-w-0 flex flex-col gap-1 pr-6 sm:pr-8">
		<!-- 头部：作者名 + 订阅角标 + 具体发布时间 -->
		<div class="text-xs text-neutral-500 dark:text-neutral-400 font-medium flex items-center gap-2 flex-wrap">
			<span class="text-neutral-700 dark:text-neutral-300 font-medium group-hover:text-(--primary) transition-colors truncate max-w-40 sm:max-w-64">
				{item.friendName}
			</span>
			{item.sourceType === "subscription" && (
				<span class="text-[10px] px-1.5 py-0.2 rounded-md bg-(--primary)/10 text-(--primary) font-normal border border-(--primary)/20 shrink-0">
					{item.tags?.[0] || i18n(I18nKey.fcircleSubscription)}
				</span>
			)}
			{item.sourceType === "self" && (
				<span class="text-[10px] px-1.5 py-0.2 rounded-md bg-(--primary)/15 text-(--primary) font-medium border border-(--primary)/30 shrink-0">
					{i18n(I18nKey.fcircleAuthor)}
				</span>
			)}
			{timeStr && timeStr !== "00:00" && (
				<>
					<span class="w-1 h-1 rounded-full bg-neutral-300 dark:bg-neutral-600 shrink-0"></span>
					<span class="tabular-nums text-neutral-400 shrink-0">{timeStr}</span>
				</>
			)}
		</div>

		<!-- 动态标题 -->
		<h3 class="font-bold text-base sm:text-lg text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors line-clamp-2 leading-snug my-0.5">
			{item.title}
		</h3>

		<!-- 动态摘要 -->
		{item.excerpt && (
			<p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2 leading-relaxed m-0">
				{item.excerpt}
			</p>
		)}
	</div>
</a>
