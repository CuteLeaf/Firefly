---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
	encrypted?: boolean;
}

const {
	id,
	name,
	cover,
	description,
	date,
	location,
	tags,
	photoCount,
	encrypted,
} = Astro.props;

const detailUrl = url(`/gallery/${id}/`);

// LQIP 渐变占位
const lqipProps = cover ? getLqipProps(cover, undefined, true) : { style: "" };

// 标签：只显示前 N 个，超出折叠成 +N
const maxTags = 2;
const visibleTags = (tags || []).slice(0, maxTags);
const hiddenTagCount = (tags || []).length - visibleTags.length;

// 网格封面是否撑满贴边，跟随文章列表设置（postListLayout.grid.coverFullWidth）
const gridCoverFullWidth =
	siteConfig.postListLayout.grid.coverFullWidth ?? false;

const coverClass = gridCoverFullWidth
	? "album-card-image group relative block aspect-2/1 overflow-hidden"
	: "album-card-image group relative block aspect-2/1 overflow-hidden mx-4 mt-4 rounded-xl";
---

<div
  class="album-card card-base flex flex-col w-full rounded-(--radius-large) overflow-hidden relative"
  data-tags={tags?.join(",") || ""}
>
  <!-- 封面（在上） -->
  <a href={detailUrl} aria-label={name} class={coverClass}>
    {cover ? (
      <>
        <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>
        <img
          src={cover}
          alt={name}
          class="w-full h-full object-cover pointer-events-none opacity-0 transition-all duration-500 ease-out group-hover:scale-110"
          loading="lazy"
          decoding="async"
        />
      </>
    ) : (
      <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
        <Icon name="material-symbols:photo-library" class="text-gray-400 text-6xl" />
      </div>
    )}

    <!-- 悬浮：变暗 + 箭头 -->
    <div class="absolute inset-0 pointer-events-none z-10 transition group-hover:bg-black/30" />
    <div class="absolute inset-0 pointer-events-none z-20 flex items-center justify-center">
      <Icon
        name="material-symbols:chevron-right-rounded"
        class="transition opacity-0 scale-50 group-hover:opacity-100 group-hover:scale-100 text-white text-5xl"
      />
    </div>

    <!-- 照片张数徽标 -->
    <div class="absolute top-3 right-3 z-30 px-2.5 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-md">
      {photoCount} {i18n(I18nKey.galleryPhotos)}
    </div>

    <!-- 加密徽标 -->
    {encrypted && (
      <div class="absolute top-3 left-3 z-30 px-2.5 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-md flex items-center gap-1">
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/></svg>
      </div>
    )}
  </a>

  <!-- 内容（在下） -->
  <div class="p-4 flex flex-col flex-1 min-h-0">
    <a
      href={detailUrl}
      class="album-card-title font-bold text-[1.35rem] leading-[1.75rem] text-black/90 dark:text-white/90 line-clamp-1 hover:text-(--primary) transition-colors"
    >
      {name}
    </a>

    <!-- 日期 + 标签 -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-1">
      {date && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon name="material-symbols:calendar-today-outline-rounded" class="text-xl" />
          </div>
          <span class="text-50 text-sm font-medium">{date}</span>
        </div>
      )}
      {visibleTags.length > 0 && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon name="material-symbols:tag-rounded" class="text-xl" />
          </div>
          <span class="flex flex-row flex-nowrap items-center">
            {visibleTags.map((tag, i) => (
              <span class="flex items-center">
                {i !== 0 && (
                  <span class="mx-1.5 text-sm font-medium text-(--meta-divider)">/</span>
                )}
                <span class="text-50 text-sm font-medium whitespace-nowrap">{tag}</span>
              </span>
            ))}
            {hiddenTagCount > 0 && (
              <span class="ml-1.5 text-50 text-sm font-medium">+{hiddenTagCount}</span>
            )}
          </span>
        </div>
      )}
    </div>

    {description && (
      <p class="album-card-desc description text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mt-2" title={description}>
        {description}
      </p>
    )}

    <!-- 底部：地点（左）+ 查看详情（右） -->
    <div class="mt-auto pt-4 flex items-center gap-2">
      {location && (
        <span class="album-card-location flex items-center gap-1 min-w-0 text-50 text-sm font-medium">
          <Icon name="material-symbols:location-on-outline-rounded" class="text-base shrink-0" />
          <span class="truncate">{location}</span>
        </span>
      )}
      <a
        href={detailUrl}
        class="ml-auto shrink-0 inline-flex items-center gap-1 text-xs font-medium text-neutral-500 dark:text-neutral-400 hover:text-(--primary) transition-colors"
      >
        {i18n(I18nKey.galleryEnterAlbum)}
        <Icon name="material-symbols:chevron-right-rounded" class="text-sm" />
      </a>
    </div>
  </div>
</div>
