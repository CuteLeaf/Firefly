<div id="calc-container" style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; max-width: 600px; margin: 20px auto; font-family: system-ui, sans-serif;">
  <h3 style="margin-top: 0; font-size: 1.2rem;">
    🧮 你的小腿需要扛多少力？
  </h3>
  
  <div style="margin-bottom: 15px;">
    <label style="display: block; margin-bottom: 5px; font-weight: bold;">1. 你的性别</label>
    <div style="display: flex; gap: 20px;">
      <label><input type="radio" name="gender" value="male" checked /> 男生</label>
      <label><input type="radio" name="gender" value="female" /> 女生</label>
    </div>
  </div>
  
  <div style="margin-bottom: 15px;">
    <label style="display: block; margin-bottom: 5px; font-weight: bold;">2. 你的体重 (kg)</label>
    <input type="number" id="weight" value="68" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px;" min="10" max="200" />
  </div>
  
  <div style="margin-bottom: 20px;">
    <label style="display: block; margin-bottom: 5px; font-weight: bold;">3. 你的脚长 (cm) <span style="font-weight: normal; color: #64748b;">（量一下鞋码对应的脚长）</span></label>
    <input type="number" id="footCm" value="25" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px;" step="0.1" min="10" max="30" />
  </div>
  
  <div style="padding: 15px; border-radius: 8px; border: 1px solid #e2e8f0; text-align: center;">
    <p style="margin: 5px 0; font-size: 0.95rem;">
      👉 你的小腿前侧需要持续付出：
    </p>
    <p style="font-size: 32px; font-weight: bold; margin: 5px 0;">
      <span id="F_pull">37.5</span> <span style="font-size: 16px; font-weight: normal;">牛顿 (N)</span>
    </p>
    <p style="font-size: 14px; margin: 8px 0;">
      💡 相当于：你的脚踝上一直悬吊着一瓶 <strong><span id="kg_eq">3.75</span> 公斤</strong> 的矿泉水！
    </p>
  </div>

  <div style="margin-top: 15px; padding: 12px;border-radius: 6px; font-size: 0.9rem;; border: 1px dashed #94a3b8;">
    <strong>👥 性别反差对比：</strong>
    <span id="diffText"> 如果你是一位男性，在体重和脚长完全相同的情况下，你的小腿将会多承受 <strong style="color: #dc2626;">1.55 公斤</strong> 的等效负重。</span>
  </div>
  
  <p style="margin-top: 15px; font-size: 12px; text-align: center;">
    * 计算基于本文推导公式：F = K × 体重 × 脚长 (K值男女有别)
  </p>
</div>

<script>
// 直接使用原生 JavaScript 操作 DOM
const g = 10;
const L_arm = 0.03;
const k2 = 0.4415;

const genderRadios = document.getElementsByName('gender');
const weightInput = document.getElementById('weight');
const footCmInput = document.getElementById('footCm');

const displayF = document.getElementById('F_pull');
const displayKg = document.getElementById('kg_eq');
const displayDiff = document.getElementById('diffText');

function updateCalculator() {
  // 获取选中的性别
  let gender = 'male';
  for (let radio of genderRadios) {
    if (radio.checked) gender = radio.value;
  }

  const M = parseFloat(weightInput.value) || 0;
  const footCm = parseFloat(footCmInput.value) || 0;
  const L = footCm / 100;

  if (M === 0 || L === 0) {
    displayF.textContent = '--';
    displayKg.textContent = '--';
    displayDiff.innerHTML = ' 请正确输入参数';
    return;
  }

  const k1 = gender === 'male' ? 0.015 : 0.012;
  const K = (k1 * k2 * g) / L_arm;
  const F_pull = K * M * L;
  const kg_eq = F_pull / g;

  displayF.textContent = F_pull.toFixed(1);
  displayKg.textContent = kg_eq.toFixed(2);

  // 计算性别差异
  const K_male = (0.015 * k2 * g) / L_arm;
  const K_female = (0.012 * k2 * g) / L_arm;
  const diffN = (K_male - K_female) * M * L;
  const diffKg = diffN / g;

  if (gender === 'male') {
    displayDiff.innerHTML = ` 如果你是一位女性，在体重和脚长完全相同的情况下，你的小腿将会少承受 <strong style="color: #059669;">${diffKg.toFixed(2)} 公斤</strong> 的等效负重。`;
  } else {
    displayDiff.innerHTML = ` 如果你是一位男性，在体重和脚长完全相同的情况下，你的小腿将会多承受 <strong style="color: #dc2626;">${diffKg.toFixed(2)} 公斤</strong> 的等效负重。`;
  }
}

// 绑定事件监听（支持实时输入计算和点击）
const inputs = [weightInput, footCmInput, ...genderRadios];
inputs.forEach(el => el.addEventListener('input', updateCalculator));
inputs.forEach(el => el.addEventListener('change', updateCalculator));

// 页面加载时初始化运行一次
updateCalculator();
</script>