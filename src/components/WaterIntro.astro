---
import { waterIntroConfig } from "@/config";
import { url } from "@/utils/url-utils";

const {
	enable,
	playOncePerSession,
	sessionStorageKey,
	startDelayMs,
	durationMs,
	zIndex,
	waterColor,
	skipButtonLabel,
} = waterIntroConfig;

const homePath = url("/");
const waveSources = Array.from({ length: 5 }, (_, index) =>
	url(`/intro/waves/wave-${index + 1}.svg`),
);
---

{
	enable && (
		<div id="water-intro" class="water-intro" data-state="idle">
			<div class="startwaves" data-water-curtain aria-hidden="true">
				<div class="waves">
					{waveSources.map((source) => (
						<img src={source} alt="" draggable="false" />
					))}
				</div>
			</div>

			<button
				type="button"
				class="water-intro__skip"
				data-water-skip
				aria-label={skipButtonLabel}
			>
				<span>{skipButtonLabel}</span>
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M7 5.5 14 12l-7 6.5V5.5Zm8.5 0h2v13h-2v-13Z" />
				</svg>
			</button>
		</div>
	)
}

<script
	is:inline
	define:vars={{
		homePath,
		playOncePerSession,
		sessionStorageKey,
		startDelayMs,
		durationMs,
	}}
>
	(() => {
		const root = document.getElementById("water-intro");
		if (!root || root.dataset.initialized === "true") return;

		const curtain = root.querySelector("[data-water-curtain]");
		const skipButton = root.querySelector("[data-water-skip]");
		if (!(curtain instanceof HTMLElement) || !(skipButton instanceof HTMLButtonElement)) {
			root.remove();
			return;
		}

		root.dataset.initialized = "true";

		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let fallbackTimer = 0;
		let cleanedUp = false;

		const normalizePath = (path) => {
			const normalized = path.replace(/\/+$/, "");
			return normalized || "/";
		};

		const isHomePage = () =>
			normalizePath(window.location.pathname) === normalizePath(homePath);

		const hasPlayed = () => {
			if (!playOncePerSession) return false;
			try {
				return sessionStorage.getItem(sessionStorageKey) === "true";
			} catch {
				return false;
			}
		};

		const markAsPlayed = () => {
			if (!playOncePerSession) return;
			try {
				sessionStorage.setItem(sessionStorageKey, "true");
			} catch {
				// sessionStorage may be unavailable in strict privacy modes.
			}
		};

		const cleanup = () => {
			if (cleanedUp) return;
			cleanedUp = true;

			window.clearTimeout(fallbackTimer);
			document.removeEventListener("keydown", handleKeydown);
			document.removeEventListener("DOMContentLoaded", maybePlay);
			document.removeEventListener("swup:contentReplaced", handlePageChange);
			skipButton.removeEventListener("click", skip);
			curtain.removeEventListener("animationend", handleAnimationEnd);
			root.remove();
		};

		const skip = () => {
			markAsPlayed();
			cleanup();
		};

		const handleKeydown = (event) => {
			if (event.key === "Escape") skip();
		};

		const handleAnimationEnd = (event) => {
			if (event.target !== curtain) return;
			cleanup();
		};

		const maybePlay = () => {
			if (cleanedUp || root.dataset.state !== "idle" || !isHomePage()) return;

			if (reducedMotion.matches || hasPlayed()) {
				markAsPlayed();
				cleanup();
				return;
			}

			markAsPlayed();
			root.dataset.state = "running";
			root.classList.add("is-running");

			document.addEventListener("keydown", handleKeydown);
			skipButton.addEventListener("click", skip);
			curtain.addEventListener("animationend", handleAnimationEnd);

			fallbackTimer = window.setTimeout(
				cleanup,
				startDelayMs + durationMs + 1000,
			);
		};

		const handlePageChange = () => {
			requestAnimationFrame(maybePlay);
		};

		if (reducedMotion.matches || hasPlayed()) {
			markAsPlayed();
			cleanup();
			return;
		}

		document.addEventListener("swup:contentReplaced", handlePageChange);

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", maybePlay, { once: true });
		} else {
			maybePlay();
		}
	})();
</script>

<style
	define:vars={{
		"water-intro-delay": `${startDelayMs}ms`,
		"water-intro-duration": `${durationMs}ms`,
		"water-intro-z-index": zIndex,
		"water-intro-color": waterColor,
	}}
>
	.water-intro {
		--water-wave-height: clamp(7.5rem, 12vw, 13.75rem);

		position: fixed;
		inset: 0;
		z-index: var(--water-intro-z-index);
		visibility: hidden;
		overflow: hidden;
		pointer-events: none;
		isolation: isolate;
	}

	.water-intro.is-running {
		visibility: visible;
		pointer-events: auto;
	}

	.startwaves {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 120svh;
		background: var(--water-intro-color);
		transform: translate3d(0, -10svh, 0);
		will-change: transform;
		animation: water-intro-down var(--water-intro-duration)
			cubic-bezier(0.22, 0.72, 0.18, 1) var(--water-intro-delay) both;
	}

	.waves {
		position: absolute;
		right: 0;
		bottom: 100%;
		left: 0;
		height: var(--water-wave-height);
		pointer-events: none;
	}

	.waves img {
		position: absolute;
		right: 0;
		bottom: -1px;
		left: 0;
		display: block;
		width: 100%;
		height: var(--water-wave-height);
		object-fit: fill;
		user-select: none;
	}

	.waves img:nth-child(1) {
		bottom: -2px;
		opacity: 0.8;
		animation: water-wave-drift-1 5s ease-in-out infinite;
	}

	.waves img:nth-child(2) {
		bottom: 0.5vw;
		opacity: 0.7;
		animation: water-wave-drift-2 4s ease-in-out infinite;
	}

	.waves img:nth-child(3) {
		bottom: 0.3vw;
		opacity: 0.6;
		animation: water-wave-drift-3 3.5s ease-in-out infinite;
	}

	.waves img:nth-child(4) {
		bottom: 0.1vw;
		opacity: 0.5;
		animation: water-wave-drift-4 3s ease-in-out infinite;
	}

	.waves img:nth-child(5) {
		bottom: -1vw;
	}

	.water-intro__skip {
		position: fixed;
		top: max(1rem, env(safe-area-inset-top));
		right: max(1rem, env(safe-area-inset-right));
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.75rem;
		padding: 0.65rem 0.8rem 0.65rem 1rem;
		border: 1px solid rgb(255 255 255 / 48%);
		border-radius: 999px;
		color: #fff;
		background: rgb(5 52 99 / 32%);
		box-shadow: 0 0.5rem 1.5rem rgb(5 52 99 / 18%);
		font: 600 0.875rem/1 system-ui, sans-serif;
		letter-spacing: 0.08em;
		backdrop-filter: blur(10px);
		cursor: pointer;
		transition:
			background-color 160ms ease,
			border-color 160ms ease,
			transform 160ms ease;
	}

	.water-intro__skip:hover {
		border-color: rgb(255 255 255 / 75%);
		background: rgb(5 52 99 / 52%);
		transform: translateY(-1px);
	}

	.water-intro__skip:focus-visible {
		outline: 3px solid #fff;
		outline-offset: 3px;
	}

	.water-intro__skip svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: currentColor;
	}

	@keyframes water-intro-down {
		from {
			transform: translate3d(0, -10svh, 0);
		}

		to {
			transform: translate3d(
				0,
				calc(110svh + var(--water-wave-height)),
				0
			);
		}
	}

	@keyframes water-wave-drift-1 {
		50% {
			transform: translateY(2.2rem);
		}
	}

	@keyframes water-wave-drift-2 {
		50% {
			transform: translateY(1.55rem);
		}
	}

	@keyframes water-wave-drift-3 {
		50% {
			transform: translateY(1.25rem);
		}
	}

	@keyframes water-wave-drift-4 {
		50% {
			transform: translateY(1.25rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.water-intro {
			display: none;
		}
	}
</style>
