---
// 洪墨 / 天利 GPT 智能摘要（第三方服务，需要有效的 key）
// 适配 Firefly + Swup：切页后自动重新初始化
---

<div class="hongmo-ai-container mt-4" id="hongmo-ai-container"></div>

<script is:inline>
  (function () {
    var TIANLI_CSS = "https://ai.zhheo.com/static/public/tianli_gpt.min.css";
    var TIANLI_JS = "https://ai.zhheo.com/static/public/tianli_gpt.min.js";

    // 配置项（与原 fuwari 站点一致）
    window.tianliGPT_postSelector = ".markdown-content";
    window.tianliGPT_postURL = "*/posts/*";
    window.tianliGPT_wordLimit = 700;
    window.tianliGPT_Title = "智能摘要";
    window.tianliGPT_key = "S-HMJ7UXQGBIAZ0U8Q";

    // 注入样式（只注入一次）
    if (!document.querySelector("link[data-tianli-gpt-css]")) {
      var link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = TIANLI_CSS;
      link.setAttribute("data-tianli-gpt-css", "");
      document.head.appendChild(link);
    }

    function ensureScript() {
      return new Promise(function (resolve) {
        if (window.tianliGPT) return resolve();
        if (!window.__tianliGptLoading) {
          window.__tianliGptLoading = true;
          var s = document.createElement("script");
          s.src = TIANLI_JS;
          s.async = true;
          s.onload = function () {
            resolve();
          };
          document.body.appendChild(s);
          return;
        }
        // 正在加载中，轮询等待
        var timer = setInterval(function () {
          if (window.tianliGPT) {
            clearInterval(timer);
            resolve();
          }
        }, 200);
      });
    }

    function run() {
      // 去重：避免脚本重跑与 Swup 钩子同时触发
      var now = Date.now();
      if (now - (window.__tianliGptLastRun || 0) < 500) return;
      window.__tianliGptLastRun = now;

      var old = document.querySelector("#tianliGPT");
      if (old) old.remove();

      ensureScript().then(function () {
        if (
          window.tianliGPT &&
          typeof window.tianliGPT.checkURLAndRun === "function"
        ) {
          setTimeout(function () {
            if (document.querySelector(".markdown-content")) {
              window.tianliGPT.checkURLAndRun();
            }
          }, 400);
        }
      });
    }

    run();

    // Swup 切页后重新初始化（钩子只绑定一次）
    if (!window.__tianliGptHookBound) {
      window.__tianliGptHookBound = true;
      var bindHook = function (swup) {
        if (swup && swup.hooks) {
          swup.hooks.on("content:replace", function () {
            setTimeout(run, 200);
          });
        }
      };
      if (window.swup) {
        bindHook(window.swup);
      } else {
        document.addEventListener("swup:enable", function () {
          bindHook(window.swup);
        });
      }
    }
  })();
</script>
