---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "overflow-visible!", "relative", "z-30", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon is:inline
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.map(item => {
                const showName = item.showName;
                const className = showName 
                    ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95 flex items-center" 
                    : "btn-regular rounded-lg h-10 w-10 active:scale-90 flex items-center justify-center";
                const targetUrl = item.interaction?.copyText ? item.url : (item.url.startsWith("mailto:") ? "#" : item.url);

                if (item.url.startsWith("mailto:") && !item.interaction?.copyText) {
                    const encodedEmail = Buffer.from(item.url.replace("mailto:", "")).toString("base64");
                    return (
                        <div
                            class="profile-social-item"
                            data-nav-social-item={item.interaction ? "" : undefined}
                            data-copy-text={item.interaction?.copyText}
                            data-open-delay-ms={item.interaction?.openDelayMs}
                            data-link-href={item.interaction ? item.url : undefined}
                        >
                            <a
                                rel="me"
                                aria-label={item.name}
                                href="#"
                                data-encoded-email={encodedEmail}
                                onclick={`
                                    (function() {
                                        const encodedEmail = this.getAttribute('data-encoded-email');
                                        const decodedEmail = atob(encodedEmail);
                                        this.href = 'mailto:' + decodedEmail;
                                        this.removeAttribute('data-encoded-email');
                                        this.removeAttribute('onclick');
                                        this.click();
                                        return false;
                                    }).call(this);
                                `.replace(/\s+/g, " ").trim()}
                                class={className}
                            >
                                <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                                {showName && item.name}
                            </a>
                            {item.interaction?.qrCode && (
                                <div class="nav-qr-popover" data-nav-qr-popover aria-hidden="true">
                                    <img
                                        src={item.interaction.qrCode}
                                        alt={item.interaction.qrCodeAlt || `${item.name} 二维码`}
                                        width="176"
                                        height="176"
                                        loading="lazy"
                                        data-nav-qr-image
                                    />
                                    <span class="nav-qr-error hidden" data-nav-qr-error>二维码加载失败</span>
                                </div>
                            )}
                        </div>
                    );
                }

                return (
                    <div
                        class="profile-social-item"
                        data-nav-social-item={item.interaction ? "" : undefined}
                        data-copy-text={item.interaction?.copyText}
                        data-open-delay-ms={item.interaction?.openDelayMs}
                        data-link-href={item.interaction ? item.url : undefined}
                    >
                        <a
                            rel="me"
                            aria-label={item.name}
                            href={targetUrl}
                            target={item.interaction?.copyText ? undefined : "_blank"}
                            class={className}
                        >
                            <Icon is:inline name={item.icon} class="text-[1.5rem]"></Icon>
                            {showName && item.name}
                        </a>
                        {item.interaction?.qrCode && (
                            <div class="nav-qr-popover" data-nav-qr-popover aria-hidden="true">
                                <img
                                    src={item.interaction.qrCode}
                                    alt={item.interaction.qrCodeAlt || `${item.name} 二维码`}
                                    width="176"
                                    height="176"
                                    loading="lazy"
                                    data-nav-qr-image
                                />
                                <span class="nav-qr-error hidden" data-nav-qr-error>二维码加载失败</span>
                            </div>
                        )}
                    </div>
                );
            })}
        </div>
  </div>
</div>

<style>
	@reference "../../styles/main.css";

	.profile-social-item {
		@apply relative z-40 inline-block;
	}

	.nav-qr-popover {
		@apply absolute invisible opacity-0 pointer-events-none z-100 w-[194px] min-w-[194px] rounded-lg border border-black/10 dark:border-white/15 bg-white dark:bg-neutral-800 p-2 shadow-xl transition-opacity duration-150 box-border;
	}

	[data-nav-social-item]:hover > .nav-qr-popover,
	[data-nav-social-item]:focus-within > .nav-qr-popover,
	.nav-qr-popover[data-visible="true"] {
		@apply visible opacity-100;
	}

	.nav-qr-popover img {
		@apply block size-44 rounded object-contain bg-white;
	}

	.nav-qr-error {
		@apply size-44 items-center justify-center px-3 text-center text-sm text-black/60 dark:text-white/60;
	}
</style>
