---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}
const { style } = Astro.props;
const className = Astro.props.class;

const encodeContactValue = (value: string) =>
	Buffer.from(value).toString("base64");
---

<div class:list={["card-base", "p-3", className]} style={style} data-profile-card>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mt-0 mb-3 w-40 h-40
       overflow-hidden rounded-full border border-(--accent-gold) active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon is:inline
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      {profileConfig.name}
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      {profileConfig.bio}
    </div>
		<div class="flex flex-wrap gap-2 justify-center mb-1">
			{profileConfig.links.map((item) => {
				const showName = profileConfig.links.length === 1 || item.showName;
				const linkClass = showName
					? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95"
					: "btn-regular rounded-lg h-10 w-10 active:scale-90";

				if (item.type === "dialog") {
					return (
						<button
							type="button"
							aria-label={item.name}
							class={linkClass}
							data-profile-contact-trigger
							data-contact-title={item.title || item.name}
							data-contact-value={encodeContactValue(item.value)}
						>
							<Icon is:inline name={item.icon} class="text-[1.5rem]" />
							{showName && item.name}
						</button>
					);
				}

				return (
					<a
						rel="me"
						aria-label={item.name}
						href={item.url}
						target="_blank"
						class={linkClass}
					>
						<Icon is:inline name={item.icon} class="text-[1.5rem]" />
						{showName && item.name}
					</a>
				);
			})}
		</div>
  </div>

<dialog
	data-profile-contact-dialog
	class="m-auto w-[min(90vw,24rem)] rounded-2xl border border-black/10 dark:border-white/10 bg-white/95 dark:bg-[#182236]/95 p-0 text-neutral-800 dark:text-neutral-100 shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm"
>
	<div class="p-5">
		<div class="flex items-center justify-between gap-4 mb-4">
			<h2 class="text-lg font-bold" data-contact-dialog-title>联系方式</h2>
			<button
				type="button"
				class="btn-regular rounded-lg h-9 w-9 active:scale-90"
				aria-label="关闭弹窗"
				data-contact-dialog-close
			>
				<Icon is:inline name="fa7-solid:xmark" class="text-lg" />
			</button>
		</div>
		<div class="rounded-xl bg-black/5 dark:bg-white/6 px-4 py-3 font-mono text-center break-all select-all" data-contact-dialog-value></div>
		<button
			type="button"
			class="btn-regular rounded-xl w-full h-10 mt-4 font-bold active:scale-[0.98]"
			data-contact-dialog-copy
		>
			复制
		</button>
	</div>
</dialog>
</div>

<script>
	document.querySelectorAll<HTMLElement>("[data-profile-card]").forEach((card) => {
		const contactDialog = card.querySelector<HTMLDialogElement>(
			"[data-profile-contact-dialog]",
		);
		if (!contactDialog) return;

		const title = contactDialog.querySelector<HTMLElement>(
			"[data-contact-dialog-title]",
		);
		const value = contactDialog.querySelector<HTMLElement>(
			"[data-contact-dialog-value]",
		);
		const copyButton = contactDialog.querySelector<HTMLButtonElement>(
			"[data-contact-dialog-copy]",
		);
		let contactValue = "";

		card
			.querySelectorAll<HTMLElement>("[data-profile-contact-trigger]")
			.forEach((trigger) => {
				trigger.addEventListener("click", () => {
					const encodedValue = trigger.dataset.contactValue;
					if (!encodedValue || !title || !value || !copyButton) return;

					contactValue = atob(encodedValue);
					title.textContent = trigger.dataset.contactTitle || "联系方式";
					value.textContent = contactValue;
					copyButton.textContent = "复制";
					contactDialog.showModal();
				});
			});

		contactDialog
			.querySelector<HTMLElement>("[data-contact-dialog-close]")
			?.addEventListener("click", () => contactDialog.close());

		contactDialog.addEventListener("click", (event) => {
			if (event.target === contactDialog) contactDialog.close();
		});

		copyButton?.addEventListener("click", async () => {
			if (!contactValue) return;
			try {
				await navigator.clipboard.writeText(contactValue);
				copyButton.textContent = "已复制";
			} catch {
				copyButton.textContent = "复制失败";
			}
		});
	});
</script>
