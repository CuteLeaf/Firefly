---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStats from "@/components/layout/PostStats.astro";
import { siteConfig } from "@/config";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	password?: boolean;
	variant?: "featured" | "compact" | "default";
	coverSide?: "left" | "right";
	style: string;
	loading?: "lazy" | "eager";
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	pinned,
	password,
	variant = "default",
	coverSide = "right",
	style,
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(image, entry.id);
const apiUrls = getApiUrlList(image, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const coverWidth = "30%";

// 网格模式封面是否撑满卡片贴边，false 则按卡片内容区的内边距内缩（间距随断点变化）
const gridCoverFullWidth =
	siteConfig.postListLayout.grid.coverFullWidth ?? false;

const descriptionLines = Math.max(
	0,
	Math.trunc(siteConfig.postListLayout.descriptionLines ?? 2),
);

// PostMeta 配置
const metaConfig = siteConfig.postListLayout.meta ?? {};
const showCategory = metaConfig.showCategory ?? true;
const metaShowTags = metaConfig.showTags ?? true;
const metaTagCount =
	metaConfig.tagCount !== undefined
		? Math.max(0, Math.trunc(metaConfig.tagCount))
		: 1;
const metaShowWords = metaConfig.showWords ?? true;
const metaShowReadingTime = metaConfig.showReadingTime ?? true;
const metaShowPublished = metaConfig.showPublished ?? true;

// PostStats 配置
const statsConfig = siteConfig.postListLayout.stats ?? {};
const statsShowPublished = statsConfig.showPublished ?? true;
const statsShowWords = statsConfig.showWords ?? true;
const statsShowReadingTime = statsConfig.showReadingTime ?? true;

// 标签显示位置
const tagsPosition = siteConfig.postListLayout.tagsPosition ?? "meta";
const showTagsInMeta = metaShowTags && tagsPosition === "meta";
const showTagsAtBottom = metaShowTags && tagsPosition === "bottom";
// 底部标签样式："chip" 按钮样式，"text" 纯文字无底色
const bottomTagsAsText =
	(siteConfig.postListLayout.tagsBottomStyle ?? "chip") === "text";
const descriptionClampLines = String(descriptionLines);
const shouldClampDescription = descriptionLines > 0;

// 底部标签：超出 tagCount 的部分折叠成一个 +N 提示，tagCount 为 0 时不限制
const tagList = tags ?? [];
const bottomTags = metaTagCount > 0 ? tagList.slice(0, metaTagCount) : tagList;
const hiddenTags = tagList.slice(bottomTags.length);
const hiddenTagCount = hiddenTags.length;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const words = remarkPluginFrontmatter.words;
const minutes = remarkPluginFrontmatter.minutes;
---

<div
  class:list={[
    "post-card-wrapper",
    hasCover ? "has-cover" : "no-cover",
    pinned ? "pinned" : "",
    `post-card-${variant}`,
    `cover-${coverSide}`,
    gridCoverFullWidth ? "" : "grid-cover-inset",
    "card-base flex flex-col-reverse w-full rounded-(--radius-large) overflow-hidden relative",
    className,
  ]}
  style={style}
>
  <!-- pinned icon -->
  <div
    class:list={[
      "post-card-content",
      "pl-4 md:pl-9 pr-4 md:pr-2 pt-4 md:pt-7 pb-4 md:pb-7 relative flex flex-col h-full",
      {
        "w-full md:w-[calc(100%-52px-12px)]": !hasCover,
        "w-full md:w-[calc(100%-var(--coverWidth)-1.5rem)]": hasCover,
      },
    ]}
  >
    <a
      href={url}
      class="post-card-title transition group w-full block font-bold mb-3 text-3xl text-90
        hover:text-(--primary) dark:hover:text-(--primary)
        active:text-(--title-active) dark:active:text-(--title-active)
        before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
        before:absolute before:top-[35px] before:left-[18px] before:hidden md:before:block"
    >
      {title}

      {
        password && (
          <Icon
            is:inline
            name="material-symbols:lock-outline"
            class="inline text-2xl align-middle -translate-y-px"
          />
        )
      }
    </a>

    <!-- metadata -->
    <PostMetadata
      published={published}
      tags={tags}
      showPublished={metaShowPublished}
      showCategory={showCategory}
      showTags={showTagsInMeta}
      maxTags={metaTagCount > 0 ? metaTagCount : undefined}
      showNoTags={true}
      hideUpdateDate={true}
      category={category || undefined}
      pinned={pinned}
      words={words}
      minutes={minutes}
      showWords={metaShowWords}
      showReadingTime={metaShowReadingTime}
      className="mb-4 post-meta card-header-meta"
    />

    <!-- description -->
    <div
      class:list={[
        "transition text-75 md:pr-4 description grow",
        { "description-clamped": shouldClampDescription },
      ]}
      title={descriptionText}
    >
      {descriptionText}
    </div>

    <!-- bottom tags（与 stats 二选一） -->
    {showTagsAtBottom && bottomTags.length > 0 && (
      <div
        class:list={[
          "post-card-bottom-tags flex flex-wrap items-center mt-auto pt-3",
          bottomTagsAsText ? "gap-x-3 gap-y-1" : "gap-1.5",
        ]}
      >
        {bottomTags.map((tag) => (
          <a
            href={getTagUrl(tag)}
            aria-label={`View all posts with the ${tag.trim()} tag`}
            class:list={[
              "transition text-xs font-medium",
              bottomTagsAsText
                ? "text-50 hover:text-(--primary)"
                : "tag-item px-2.5 py-1",
            ]}
          >
            #{tag.trim()}
          </a>
        ))}
        {hiddenTagCount > 0 && (
          <span
            title={hiddenTags.map((tag) => `#${tag.trim()}`).join(" ")}
            class:list={[
              "text-xs font-medium",
              bottomTagsAsText
                ? "text-50"
                : "tag-item tag-item-static px-2.5 py-1",
            ]}
          >
            +{hiddenTagCount}
          </span>
        )}
      </div>
    )}

    <!-- stats（与底部标签二选一） -->
    {!showTagsAtBottom && (
      <PostStats
        published={published}
        words={words}
        minutes={minutes}
        showPublished={statsShowPublished}
        showWords={statsShowWords}
        showReadingTime={statsShowReadingTime}
        showIcons={siteConfig.postListLayout.showStatsIcons}
        className="stats mt-auto pt-3 text-black/30 dark:text-white/30 gap-x-2"
      />
    )}
  </div>
  {
    hasCover && (
      <a
        href={url}
        aria-label={title}
        class:list={[
          "post-card-image",
          "group",
          "w-full md:w-(--coverWidth)",
          "aspect-2/1 md:aspect-auto",
          "relative md:absolute md:top-4 md:bottom-4 md:right-4",
          "rounded-(--radius-large) md:rounded-xl overflow-hidden",
        ]}
      >
        <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition" />
        <div class="absolute pointer-events-none z-20 w-full h-full flex items-center justify-center ">
          <Icon
            is:inline
            name="material-symbols:chevron-right-rounded"
            class="transition opacity-0 group-hover:opacity-100 scale-50 group-hover:scale-100 text-white text-5xl"
          />
        </div>
        <CoverImage
          src={processedImage}
          basePath={getFileDirFromPath(entry.filePath || "")}
          alt="Cover Image of the Post"
          class="w-full h-full transition-transform duration-300 group-hover:scale-110 group-active:scale-115"
          preview={true}
          loading={loading}
          apiUrls={apiUrls}
        />
      </a>
    )
  }

  {
    !hasCover && (
      <a
        href={url}
        aria-label={title}
        class:list={[
          "post-card-enter-btn",
          "flex btn-regular w-13",
          "absolute right-3 top-3 bottom-3 rounded-xl bg-(--enter-btn-bg)",
          "hover:bg-(--enter-btn-bg-hover) active:bg-(--enter-btn-bg-active) active:scale-95",
        ]}
      >
        <Icon
          is:inline
          name="material-symbols:chevron-right-rounded"
          class="transition text-(--primary) text-4xl mx-auto"
        />
      </a>
    )
  }
</div>

<style define:vars={{ coverWidth, descriptionClampLines }}>
  .description-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: var(--descriptionClampLines);
    line-clamp: var(--descriptionClampLines);
  }

  /* === List Mode Mobile Styles === */
  /* 移动端列表模式：封面在右侧，内容缩小 */
  :global(.list-mode) .post-card-wrapper {
    flex-direction: row !important;
  }

  :global(.list-mode) .has-cover .post-card-content {
    width: calc(100% - 9rem - 0.75rem) !important;
    padding: 0.75rem 0.5rem 0.75rem 0.75rem !important;
  }

  :global(.list-mode) .has-cover .post-card-image {
    position: absolute !important;
    top: 0.5rem !important;
    bottom: 0.5rem !important;
    right: 0.5rem !important;
    width: 9rem !important;
    aspect-ratio: auto !important;
    border-radius: 0.75rem !important;
  }

  /* 封面在左侧：封面改钉左边，内容用 margin-left:auto 推到右边并镜像内边距 */
  :global(.list-mode) .post-card-wrapper.cover-left.has-cover .post-card-content {
    margin-left: auto !important;
    padding: 0.75rem 0.75rem 0.75rem 0.5rem !important;
  }

  :global(.list-mode) .post-card-wrapper.cover-left.has-cover .post-card-image {
    right: auto !important;
    left: 0.5rem !important;
  }

  :global(.list-mode) .post-card-title {
    font-size: 1.125rem !important;
    line-height: 1.75rem !important;
    margin-bottom: 0.5rem !important;
  }

  :global(.list-mode) .post-card-title::before {
    display: none !important;
  }

  :global(.list-mode) .stats {
    gap: 0.25rem !important;
  }

  :global(.list-mode) .no-cover .post-card-content {
    width: calc(100% - 52px - 12px) !important;
  }

  :global(.list-mode) .post-card-enter-btn {
    display: flex !important;
  }

  /* 移动端重点文章：大封面位于内容上方，形成明确的首页入口 */
  :global(.list-mode) .post-card-featured.has-cover {
    flex-direction: column-reverse !important;
  }

  :global(.list-mode) .post-card-featured.has-cover .post-card-content {
    width: 100% !important;
    padding: 1rem 1rem 1.1rem !important;
  }

  :global(.list-mode) .post-card-featured.has-cover .post-card-image {
    position: relative !important;
    inset: auto !important;
    width: calc(100% - 2rem) !important;
    margin: 1rem 1rem 0 !important;
    aspect-ratio: 16 / 9 !important;
    border-radius: 0.875rem !important;
  }

  :global(.list-mode) .post-card-featured .post-card-title {
    font-size: 1.35rem !important;
    line-height: 1.75rem !important;
  }

  :global(.list-mode) .post-card-featured .description-clamped {
    -webkit-line-clamp: 3 !important;
    line-clamp: 3 !important;
  }

  :global(.list-mode) .post-card-compact.has-cover {
    min-height: 10.5rem;
  }

  /* 移动端列表模式 - 隐藏tags，只在有空间时显示 */
  :global(.list-mode) .stats a {
    font-size: 0.65rem !important;
    padding: 0.125rem 0.375rem !important;
    height: 1.25rem !important;
  }

  /* === Desktop List Mode overrides === */
  @media (min-width: 768px) {
    :global(.list-mode) .post-card-wrapper {
      flex-direction: row !important;
    }

    :global(.list-mode) .has-cover .post-card-content {
      width: calc(100% - var(--coverWidth) - 1.5rem) !important;
      padding: 1.75rem 0.5rem 1.75rem 2.25rem !important;
    }

    :global(.list-mode) .has-cover .post-card-image {
      top: 1rem !important;
      bottom: 1rem !important;
      right: 1rem !important;
      width: var(--coverWidth) !important;
      border-radius: 0.75rem !important;
    }

    /* 封面在左侧：内边距完全镜像右侧模式（靠封面那侧 0.5rem，靠卡片边缘那侧 2.25rem） */
    :global(.list-mode) .post-card-wrapper.cover-left.has-cover .post-card-content {
      padding: 1.75rem 2.25rem 1.75rem 0.5rem !important;
    }

    :global(.list-mode) .post-card-wrapper.cover-left.has-cover .post-card-image {
      right: auto !important;
      left: 1rem !important;
    }

    /* 标题装饰条是贴着卡片左边缘的设计，封面移到左侧后不再成立，直接隐藏 */
    :global(.list-mode) .post-card-wrapper.cover-left.has-cover .post-card-title::before {
      display: none !important;
    }

    :global(.list-mode) .post-card-title {
      font-size: 1.5rem !important;
      line-height: 2rem !important;
      margin-bottom: 0.75rem !important;
    }

    :global(.list-mode) .post-card-title::before {
      display: block !important;
      top: 2.25rem !important;
      height: 1rem !important;
    }

    :global(.list-mode) .description {
      font-size: inherit !important;
    }

    :global(.list-mode) .stats a {
      font-size: 0.75rem !important;
      padding: 0.25rem 0.5rem !important;
      height: 1.5rem !important;
    }

    :global(.list-mode) .no-cover .post-card-content {
      width: calc(100% - 52px - 12px) !important;
    }

    :global(.list-mode) .post-card-enter-btn {
      display: flex !important;
    }

    /* 首页重点文章：左侧大封面，右侧建立更清晰的阅读层级 */
    :global(.list-mode) .post-card-featured.has-cover {
      min-height: 18rem;
    }

    :global(.list-mode) .post-card-featured.has-cover .post-card-content {
      width: calc(60% - 0.75rem) !important;
      margin-left: auto !important;
      padding: 2rem 2.25rem 2rem 1rem !important;
    }

    :global(.list-mode) .post-card-featured.has-cover .post-card-image {
      position: absolute !important;
      top: 1rem !important;
      bottom: 1rem !important;
      left: 1rem !important;
      right: auto !important;
      width: 40% !important;
      margin: 0 !important;
      aspect-ratio: auto !important;
      border-radius: 0.875rem !important;
    }

    :global(.list-mode) .post-card-featured .post-card-title {
      font-size: 1.65rem !important;
      line-height: 2.15rem !important;
      margin-bottom: 0.875rem !important;
    }

    :global(.list-mode) .post-card-featured .post-card-title::before {
      display: none !important;
    }

    /* 后续文章收紧高度，并按卡片自身的 cover-left / cover-right 交错 */
    :global(.list-mode) .post-card-compact.has-cover {
      min-height: 12.5rem;
    }

    :global(.list-mode) .post-card-compact.has-cover .post-card-content {
      width: calc(66% - 0.75rem) !important;
      padding: 1.25rem 1.5rem 1.25rem 2rem !important;
    }

    :global(.list-mode) .post-card-compact.cover-left.has-cover .post-card-content {
      margin-left: auto !important;
      padding: 1.25rem 2rem 1.25rem 1.5rem !important;
    }

    :global(.list-mode) .post-card-compact.has-cover .post-card-image {
      top: 0.75rem !important;
      bottom: 0.75rem !important;
      right: 0.75rem !important;
      width: 34% !important;
    }

    :global(.list-mode) .post-card-compact.cover-left.has-cover .post-card-image {
      left: 0.75rem !important;
      right: auto !important;
    }

    :global(.list-mode) .post-card-compact .post-card-title {
      font-size: 1.35rem !important;
      line-height: 1.75rem !important;
      margin-bottom: 0.625rem !important;
    }

    :global(.list-mode) .post-card-compact .post-card-title::before {
      top: 1.7rem !important;
      height: 0.875rem !important;
    }
  }

  @media (max-width: 390px) {
    :global(.list-mode) .post-card-compact.has-cover .post-card-content {
      width: calc(100% - 7.5rem - 0.625rem) !important;
      padding: 0.7rem 0.35rem 0.7rem 0.7rem !important;
    }

    :global(.list-mode) .post-card-compact.has-cover .post-card-image {
      width: 7.5rem !important;
      top: 0.5rem !important;
      right: 0.5rem !important;
      bottom: 0.5rem !important;
    }

    :global(.list-mode) .post-card-compact .post-card-title {
      font-size: 1rem !important;
      line-height: 1.35rem !important;
    }

    :global(.list-mode) .post-card-compact .description {
      font-size: 0.82rem !important;
      line-height: 1.25rem !important;
    }
  }

  /* === Grid Mode Styles === */
  /* 网格模式：封面在顶部（移动端和桌面端一致） */
  :global(.grid-mode) .post-card-wrapper {
    flex-direction: column-reverse !important;
    height: 100% !important;
    justify-content: flex-end !important;
  }

  :global(.grid-mode) .post-card-content {
    width: 100% !important;
    height: auto !important;
    flex-grow: 1 !important;
  }

  :global(.grid-mode) .post-card-image {
    position: relative !important;
    top: auto !important;
    bottom: auto !important;
    right: auto !important;
    width: 100% !important;
    margin: 0 !important;
    border-radius: var(--radius-large) var(--radius-large) 0 0 !important;
    max-height: none !important;
    aspect-ratio: 2/1 !important;
  }

  /* 非贴边：封面按卡片内容区的内边距内缩，跟随 --grid-card-padding 随屏幕变化 */
  :global(.grid-mode) .post-card-wrapper.grid-cover-inset .post-card-image {
    width: calc(100% - var(--grid-card-padding, 1rem) * 2) !important;
    margin: var(--grid-card-padding, 1rem) var(--grid-card-padding, 1rem) 0 !important;
    border-radius: 0.75rem !important;
  }

  :global(.grid-mode) .description {
    flex-grow: 0 !important;
  }

  :global(.grid-mode) .stats {
    margin-top: auto !important;
  }

  :global(.grid-mode) .has-cover .post-card-content {
    padding-top: 0.8rem !important;
  }
  :global(.grid-mode) .has-cover .post-card-title::before {
    top: 1.3rem !important;
  }

  :global(.grid-mode) .no-cover .post-card-content {
    width: calc(100% - 52px - 12px) !important;
  }

  :global(.grid-mode) .post-card-enter-btn {
    display: flex !important;
  }
</style>
