---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	links: NavBarLink[];
}

const processedLinks = Astro.props.links;
const navTitle = siteConfig.navbar.title || siteConfig.title;
---
<div id="nav-menu-panel" class:list={["float-panel-closed absolute inset-x-0 z-1100"]} data-floating-panel data-floating-panel-trigger="nav-menu-switch" data-floating-panel-scroll-lock data-floating-panel-close-delay="300" inert aria-hidden="true">
    <!-- 一个滑动容器保证内容、毛玻璃和遮罩边缘处于同一合成坐标系。 -->
    <div class="mobile-menu-motion">
    <div class="mobile-menu-glass" aria-hidden="true"></div>
    <div class="mobile-menu-scrim" aria-hidden="true"></div>
    <!-- 抽屉：MD3 侧边导航，右侧滑入，占满整高，内部滚动 -->
    <aside class="mobile-menu-drawer" role="dialog" aria-modal="true" aria-label="导航菜单">
        <header class="mobile-menu-header">
            <span class="mobile-menu-title">{navTitle}</span>
            <button type="button" class="mobile-menu-close" aria-label="关闭菜单">
                <Icon name="material-symbols:close-rounded" class="text-[1.5rem]" />
            </button>
        </header>
        <nav class="mobile-menu-list">
            {processedLinks.map((link, index) => (
                <div class="mobile-menu-item-root">
                    {link.children && link.children.length > 0 ? (
                        /* 有子菜单的项目：MD3 手风琴 */
                        <div class="mobile-dropdown" data-mobile-dropdown>
                            <button
                                type="button"
                                class="mobile-menu-item"
                                data-mobile-dropdown-trigger
                                aria-expanded="false"
                                aria-controls={`mobile-submenu-${index}`}
                            >
								{link.icon && <Icon name={link.icon} class="mobile-menu-item-icon" />}
                                <span class="mobile-menu-item-label">{link.name}</span>
                                <Icon name="material-symbols:keyboard-arrow-down-rounded"
                                      class="mobile-menu-item-arrow"
                                />
                            </button>
                            <div id={`mobile-submenu-${index}`} class="mobile-submenu" data-mobile-submenu inert aria-hidden="true">
                                {link.children.map((child) => (
                                    <a
                                        href={child.external ? child.url : url(child.url)}
                                        class="mobile-menu-item"
                                        data-nav-href={child.external ? undefined : url(child.url)}
                                        target={child.external ? "_blank" : null}
                                    >
										{child.icon && <Icon name={child.icon} class="mobile-menu-item-icon" />}
                                        <span class="mobile-menu-item-label">{child.name}</span>
                                        {child.external && <Icon
                                            name="fa7-solid:arrow-up-right-from-square"
                                            class="mobile-menu-item-external text-[0.9rem] shrink-0"
                                        />}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ) : (
                        /* 普通链接项目 */
                        <a
                            href={link.external ? link.url : url(link.url)}
                            class="mobile-menu-item"
                            data-nav-href={link.external ? undefined : url(link.url)}
                            target={link.external ? "_blank" : null}
                        >
							{link.icon && <Icon name={link.icon} class="mobile-menu-item-icon" />}
                            <span class="mobile-menu-item-label">{link.name}</span>
							{!link.external && <Icon
                                name="material-symbols:chevron-right-rounded"
                                class="mobile-menu-item-arrow"
                            />}
							{link.external && <Icon
                                name="fa7-solid:arrow-up-right-from-square"
                                class="mobile-menu-item-external text-[0.9rem] shrink-0"
                            />}
                        </a>
                    )}
                </div>
            ))}
        </nav>
    </aside>
    </div>
</div>

<style>
    @reference "../../styles/main.css";

    /* ---- 手风琴子菜单 ---- */
    .mobile-submenu {
        overflow: hidden;
        max-height: 0;
        transition: max-height 0.3s var(--ease-standard);
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .mobile-dropdown[data-expanded="true"] .mobile-submenu {
        max-height: 60vh;
        margin-top: 4px; /* 触发器与子项之间留距 */
    }

    /* MD3 抽屉：面板改成透明全屏定位层，动画放在「遮罩/抽屉」子层上 */
    #nav-menu-panel {
        position: absolute;
        top: var(--mobile-menu-document-top, 0px);
        bottom: auto;
        height: var(--mobile-menu-paint-height, 100lvh); /* 打开时快照，避免 Safari 工具栏动画改变绘制边界 */
        overflow: clip; /* 裁掉滑出部分，避免增加页面横向滚动范围 */
        overscroll-behavior: none;
        --mobile-menu-width: min(70vw, 340px);
        border-radius: 0; /* 覆盖 .float-panel 的圆角，避免遮罩四角被裁剪 */
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        visibility: visible;
        transition: visibility 0s;
    }
    /* 关闭态：整体不可点，但不再整体淡出/下移（动画由子层负责） */
    #nav-menu-panel.float-panel-closed {
        opacity: 1;
        transform: none;
        translate: none; /* Tailwind v4 的 -translate-y-1 使用独立 translate 属性 */
        pointer-events: none;
        visibility: hidden;
        transition-delay: 0.3s; /* 等子层滑出后隐藏，清除屏幕边缘的残留阴影 */
    }

    /* Safari 浮动底栏后方使用与抽屉相同的毛玻璃。
       z-index: 0 先采样原页面；滑动容器只占可见高度，不把黑色遮罩铺到这里。 */
    #nav-menu-panel::after {
        content: "";
        position: absolute;
        top: var(--mobile-menu-visible-height, 100dvh);
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 0;
        background: var(--card-bg);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.28s var(--ease-standard);
    }
    #nav-menu-panel:not(.float-panel-closed)::after {
        opacity: 1;
    }

    /* 不给共同祖先 opacity/filter，毛玻璃继续采样真实页面。 */
    .mobile-menu-motion {
        position: absolute;
        top: 0;
        right: 0;
        width: var(--mobile-menu-width);
        height: var(--mobile-menu-visible-height, 100dvh);
        z-index: 1;
        transform: translateX(100%);
        transition: transform 0.3s var(--ease-decelerate);
        will-change: transform;
    }
    #nav-menu-panel:not(.float-panel-closed) .mobile-menu-motion {
        transform: translateX(0);
    }
    .mobile-menu-glass,
    .mobile-menu-drawer {
        position: absolute;
        inset: 0;
        box-sizing: border-box;
        border-radius: var(--radius-large) 0 0 var(--radius-large);
    }

    /* ---- 毛玻璃：位于遮罩之前，连圆角边缘的模糊采样也不会被遮罩污染 ---- */
    .mobile-menu-glass {
        z-index: 0;
        pointer-events: none;
        background: var(--card-bg);
        box-shadow: -8px 0 24px rgba(0, 0, 0, 0.15);
    }
    :root.dark .mobile-menu-glass {
        box-shadow: -8px 0 24px rgba(0, 0, 0, 0.45);
    }
    html:not([data-wallpaper-mode="none"])[data-has-wallpaper] .mobile-menu-glass,
    html:not([data-wallpaper-mode="none"]) body.wallpaper-transparent .mobile-menu-glass,
    html:not([data-wallpaper-mode="none"])[data-has-wallpaper] #nav-menu-panel::after,
    html:not([data-wallpaper-mode="none"]) body.wallpaper-transparent #nav-menu-panel::after {
        background: rgba(255, 255, 255, 0.55);
        -webkit-backdrop-filter: blur(var(--navbar-panel-blur, 20px)) saturate(1.5);
        backdrop-filter: blur(var(--navbar-panel-blur, 20px)) saturate(1.5);
    }
    :root.dark:not([data-wallpaper-mode="none"])[data-has-wallpaper] .mobile-menu-glass,
    :root.dark:not([data-wallpaper-mode="none"]) body.wallpaper-transparent .mobile-menu-glass,
    :root.dark:not([data-wallpaper-mode="none"])[data-has-wallpaper] #nav-menu-panel::after,
    :root.dark:not([data-wallpaper-mode="none"]) body.wallpaper-transparent #nav-menu-panel::after {
        background: rgba(23, 23, 23, 0.6);
    }

    /* 左侧矩形和两个圆角补集组成遮罩，无 SVG 蒙版、无巨大阴影。
       矩形向左延伸一屏：整个动画中每个抽屉外的像素均被覆盖，只改变透明度。 */
    .mobile-menu-scrim {
        --scrim-color: rgba(0, 0, 0, 0.5);
        position: absolute;
        top: 0;
        bottom: 0;
        right: 100%;
        width: 100vw;
        z-index: 1;
        background: var(--scrim-color);
        opacity: 0;
        pointer-events: none;
        touch-action: none;
        transition: opacity 0.28s var(--ease-standard);
    }
    #nav-menu-panel:not(.float-panel-closed) .mobile-menu-scrim {
        opacity: 1;
        pointer-events: auto;
    }
    :root.dark .mobile-menu-scrim {
        --scrim-color: rgba(0, 0, 0, 0.62);
    }
    .mobile-menu-scrim::before,
    .mobile-menu-scrim::after {
        content: "";
        position: absolute;
        left: 100%;
        width: var(--radius-large);
        height: var(--radius-large);
    }
    .mobile-menu-scrim::before {
        top: 0;
        background: radial-gradient(circle at 100% 100%, transparent var(--radius-large), var(--scrim-color) var(--radius-large));
    }
    .mobile-menu-scrim::after {
        bottom: 0;
        background: radial-gradient(circle at 100% 0%, transparent var(--radius-large), var(--scrim-color) var(--radius-large));
    }

    /* ---- 内容：透明独立层，不重复绘制底色或 backdrop-filter ---- */
    .mobile-menu-drawer {
        --drawer-on-surface: var(--deep-text);
        --drawer-on-surface-variant: color-mix(in oklch, var(--deep-text) 70%, transparent);
        --drawer-hover: color-mix(in oklch, var(--primary) 8%, transparent);
        --drawer-selected-bg: color-mix(in oklch, var(--primary) 14%, transparent);

        z-index: 2;
        height: 100%;
        height: var(--mobile-menu-visible-height, 100dvh); /* 菜单内容避开浏览器控件，背景继续向下绘制 */
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: transparent;
    }
    :root.dark .mobile-menu-drawer {
        --drawer-on-surface: rgba(255, 255, 255, 0.87);
        --drawer-on-surface-variant: rgba(255, 255, 255, 0.62);
    }

    @media (prefers-reduced-motion: reduce) {
        #nav-menu-panel.float-panel-closed {
            transition-delay: 0s;
        }
        #nav-menu-panel::after,
        .mobile-menu-motion,
        .mobile-menu-scrim {
            transition: none;
        }
    }

    /* ---- 头部 ---- */
    .mobile-menu-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: max(20px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) 12px 24px;
        flex-shrink: 0;
    }
    .mobile-menu-title {
        font-weight: 600;
        font-size: 1.125rem;
        color: var(--drawer-on-surface);
        user-select: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .mobile-menu-close {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-lg);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--drawer-on-surface-variant);
        transition: background-color 0.2s, color 0.2s;
    }
    .mobile-menu-close:hover {
        background: var(--drawer-hover);
        color: var(--drawer-on-surface);
    }

    /* ---- 列表 ---- */
    .mobile-menu-list {
        flex: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: 8px max(12px, env(safe-area-inset-right, 0px)) max(16px, env(safe-area-inset-bottom, 0px)) 12px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* ---- MD3 导航项：leading icon + label，pill 状态层 ---- */
    .mobile-menu-item {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        min-height: 56px;
        padding: 0 16px;
        border: none;
        border-radius: var(--radius-large);
        background: transparent;
        color: var(--drawer-on-surface-variant);
        font-size: 1rem;
        font-weight: 500;
        line-height: 1.25;
        cursor: pointer;
        user-select: none;
        text-align: left;
        transition: background-color 0.2s, color 0.2s;
    }
    .mobile-menu-item:hover {
        background: var(--drawer-hover);
        color: var(--drawer-on-surface);
    }
    .mobile-menu-item:active {
        background: color-mix(in oklch, var(--primary) 12%, transparent);
    }
    .mobile-menu-item[data-active="true"] {
        background: var(--drawer-selected-bg);
        color: var(--primary);
    }
    .mobile-menu-item-icon {
        flex-shrink: 0;
        font-size: 1.5rem;
        width: 1.5rem;
        height: 1.5rem;
    }
    .mobile-menu-item-label {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .mobile-menu-item-arrow {
        flex-shrink: 0;
        font-size: 1.25rem;
        transition: transform 0.2s;
    }
    .mobile-dropdown[data-expanded="true"] .mobile-menu-item-arrow {
        transform: rotate(180deg);
    }
    .mobile-menu-item-external {
        color: var(--drawer-on-surface-variant);
    }

    /* ---- 子项缩进 ---- */
    .mobile-submenu .mobile-menu-item {
        padding-left: 52px;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const mobileDropdowns = document.querySelectorAll("[data-mobile-dropdown]");
        mobileDropdowns.forEach((dropdown) => {
            const trigger = dropdown.querySelector("[data-mobile-dropdown-trigger]");
            const submenu = dropdown.querySelector("[data-mobile-submenu]");
            if (!trigger || !submenu) return;

            trigger.addEventListener("click", (e) => {
                e.preventDefault();
                const isExpanded = dropdown.getAttribute("data-expanded") === "true";
                mobileDropdowns.forEach((other) => {
                    if (other !== dropdown) setDropdownExpanded(other, false);
                });
                setDropdownExpanded(dropdown, !isExpanded);
            });
        });
        markActiveNav();
    });

    // 当前页高亮 + 含当前页的父级自动展开（Swup 切页后重扫）
    document.addEventListener("astro:page-load", markActiveNav);
    document.addEventListener("swup:contentReplaced", markActiveNav);

    // 遮罩点击 / 关闭按钮：文档级委托监听，跨 Swup 替换也有效
    document.addEventListener("click", (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest(".mobile-menu-scrim, .mobile-menu-close")) {
            document.getElementById("nav-menu-panel")?.classList.add("float-panel-closed");
        }
    });

    // 点击抽屉内的导航链接后关闭抽屉：内部链接走 Swup 切页、外部链接另开新标签页，
    // 两种情况都该收起来。面板在 swup 容器外、跨页持久存在（MainGridLayout 里是 body 直系子元素），
    // 不主动关的话切页后抽屉会一直开着。仅匹配 <a>，手风琴触发器是 <button>，触发展开时不关。
    document.addEventListener("click", (e) => {
        const t = e.target;
        if (t instanceof Element && t.closest(".mobile-menu-drawer a[href]")) {
            document.getElementById("nav-menu-panel")?.classList.add("float-panel-closed");
        }
    });

    function markActiveNav() {
        const path = location.pathname;
        document.querySelectorAll(".mobile-menu-item[data-nav-href]").forEach((item) => {
            const href = item.getAttribute("data-nav-href");
            let active = false;
            if (href) {
                try {
                    active = new URL(href, location.href).pathname === path;
                } catch {
                    active = false;
                }
            }
            item.setAttribute("data-active", active ? "true" : "false");
            if (active) {
                const group = item.closest("[data-mobile-dropdown]");
                if (group) setDropdownExpanded(group, true);
            }
        });
    }

    function setDropdownExpanded(dropdown: Element, isExpanded: boolean) {
        dropdown.setAttribute("data-expanded", isExpanded.toString());
        const trigger = dropdown.querySelector("[data-mobile-dropdown-trigger]");
        trigger?.setAttribute("aria-expanded", isExpanded.toString());
        const submenu = dropdown.querySelector("[data-mobile-submenu]");
        if (submenu instanceof HTMLElement) {
            submenu.inert = !isExpanded;
            submenu.setAttribute("aria-hidden", (!isExpanded).toString());
        }
    }
</script>
