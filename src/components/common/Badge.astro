---
// MDX 内联彩色徽章组件
//
// 用法（.mdx）：
//   <Badge>新功能</Badge>
//   <Badge type="tip">提示</Badge>
//   <Badge type="warning">注意</Badge>
//
// type：default 为主题色，其余对应提示框色板
//   （tip / note / important / warning / caution），可选，默认 default

type BadgeType =
	| "default"
	| "tip"
	| "note"
	| "important"
	| "warning"
	| "caution";

interface Props {
	type?: BadgeType;
	class?: string;
}

const { type = "default", class: className } = Astro.props;

const typeClasses: Record<BadgeType, string> = {
	default: "bg-(--primary)/12 text-(--primary)",
	tip: "bg-(--admonitions-color-tip)/12 text-(--admonitions-color-tip)",
	note: "bg-(--admonitions-color-note)/12 text-(--admonitions-color-note)",
	important:
		"bg-(--admonitions-color-important)/12 text-(--admonitions-color-important)",
	warning:
		"bg-(--admonitions-color-warning)/12 text-(--admonitions-color-warning)",
	caution:
		"bg-(--admonitions-color-caution)/12 text-(--admonitions-color-caution)",
};
---

<span
	class:list={[
		"inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap align-middle",
		typeClasses[type],
		className,
	]}
>
	<slot />
</span>
