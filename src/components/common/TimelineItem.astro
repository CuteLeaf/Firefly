---
import { ICONS, type IconName } from "./mdx-icons";

// MDX 时间线条目组件（配合 Timeline 使用）
//
// 属性：
// - date：时间标签，如 "2024-03-10"，可选
// - title：条目标题，可选
// - type：节点颜色，default 为主题色，其余对应提示框色板，可选
//   （tip / note / important / warning / caution）
// - icon：内置图标名，在圆点内显示，可选
//   （star / rocket / git / flag / book / heart / zap / bug / tag / calendar / code / edit）
// - children：条目正文，支持 Markdown 内容（经 <slot /> 渲染）
//
// 图标是组件内置的内联 SVG（Feather/Lucide 风格，MIT 许可），不依赖
// icons-data.json 图标库。有 icon 时圆点渲染为带图标的圆形徽章，无 icon 时
// 保持原来的小圆点。节点颜色统一由 .timeline-item 上的 --node-bg 控制。

interface Props {
	date?: string;
	title?: string;
	type?: "default" | "tip" | "note" | "important" | "warning" | "caution";
	icon?: IconName;
}

const { date, title, type = "default", icon } = Astro.props;
const iconHtml = icon ? ICONS[icon] : undefined;
---

<li class="timeline-item" data-type={type}>
	<div class="timeline-marker" aria-hidden="true">
		{iconHtml && <span class="timeline-marker-icon" set:html={iconHtml}></span>}
	</div>
	<div class="timeline-content">
		{date && <div class="timeline-item-date">{date}</div>}
		{title && <div class="timeline-item-title">{title}</div>}
		<div class="timeline-item-body">
			<slot />
		</div>
	</div>
</li>

<style>
	/* 节点颜色：default 为主题色，其余对应提示框色板 */
	.timeline-item {
		--node-bg: var(--primary);
		--node-ring: color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.timeline-item[data-type="tip"] {
		--node-bg: var(--admonitions-color-tip);
		--node-ring: color-mix(in srgb, var(--admonitions-color-tip) 22%, transparent);
	}
	.timeline-item[data-type="note"] {
		--node-bg: var(--admonitions-color-note);
		--node-ring: color-mix(in srgb, var(--admonitions-color-note) 22%, transparent);
	}
	.timeline-item[data-type="important"] {
		--node-bg: var(--admonitions-color-important);
		--node-ring: color-mix(in srgb, var(--admonitions-color-important) 22%, transparent);
	}
	.timeline-item[data-type="warning"] {
		--node-bg: var(--admonitions-color-warning);
		--node-ring: color-mix(in srgb, var(--admonitions-color-warning) 22%, transparent);
	}
	.timeline-item[data-type="caution"] {
		--node-bg: var(--admonitions-color-caution);
		--node-ring: color-mix(in srgb, var(--admonitions-color-caution) 22%, transparent);
	}

	.timeline-item {
		display: flex;
		gap: var(--spacing-lg);
		margin: 0;
		padding: 0 0 var(--spacing-2xl);
	}

	.timeline-item:last-child {
		padding-bottom: 0;
	}

	.timeline-marker {
		position: relative;
		flex-shrink: 0;
		width: var(--timeline-marker-size, 1rem);
		display: flex;
		justify-content: center;
		align-items: flex-start;
	}

	/* 无 icon：小圆点 */
	.timeline-marker::before {
		content: "";
		width: 0.625rem;
		height: 0.625rem;
		margin-top: var(--spacing-xs);
		border-radius: var(--radius-full);
		background: var(--node-bg);
		box-shadow: 0 0 0 3px var(--node-ring);
	}

	/* 有 icon：隐藏小圆点，改为带图标的圆形徽章 */
	.timeline-marker:has(.timeline-marker-icon)::before {
		content: none;
	}

	.timeline-marker-icon {
		/* 防止被标记列（flex 容器）压缩成椭圆 */
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: var(--spacing-xs);
		border-radius: var(--radius-full);
		background: var(--node-bg);
		box-shadow: 0 0 0 3px var(--node-ring);
		color: #fff;
	}

	.timeline-marker-icon :global(svg) {
		width: 0.7rem;
		height: 0.7rem;
	}

	.timeline-content {
		flex: 1;
		min-width: 0;
	}

	.timeline-item-date {
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.5;
		color: var(--btn-content);
		opacity: 0.7;
		font-variant-numeric: tabular-nums;
	}

	.timeline-item-title {
		margin-top: 0.125rem;
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.5;
		color: var(--deep-text);
	}

	/* 暗色下 --deep-text 仍为深色，需覆盖为亮色文字 */
	:global(.dark) .timeline-item-title {
		color: var(--btn-content);
	}

	.timeline-item-body {
		margin-top: var(--spacing-sm);
	}

	/* 正文首尾与标题/条目贴合，避免 prose 外边距撑出空隙（slot 内容为结构选择器，可命中） */
	.timeline-item-body > :first-child {
		margin-top: 0;
	}

	.timeline-item-body > :last-child {
		margin-bottom: 0;
	}
</style>
